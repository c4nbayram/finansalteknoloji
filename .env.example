VITE_MARKET_DATA_PROVIDER=twelvedata
VITE_MARKET_DATA_API_KEY=YOUR_TWELVE_DATA_API_KEY
VITE_MARKET_DATA_BASE_URL=https://api.twelvedata.com

# Trade Bot — sabit OpenAI anahtarı (tüm kullanıcılar bu anahtarla çalışır)
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
VITE_OPENAI_MODEL=gpt-4o-mini

# Admin Panel URL (opsiyonel - boş bırakılırsa localhost'ta admin.localhost:5173 kullanılır)
# Vercel veya production'da admin panelinin tam URL'sini buraya girin
# Örnek: https://admin-panel.vercel.app veya https://admin.yourdomain.com
VITE_ADMIN_URL=
